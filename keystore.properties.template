# Release signing config for Accrescent (and any self-distributed builds).
#
# 1. Generate a release keystore ONCE and keep it somewhere safe & backed up
#    (losing it means you can never update the app on Accrescent):
#
#      keytool -genkeypair -v \
#        -keystore astroloop-release.jks \
#        -alias astroloop -keyalg RSA -keysize 4096 -validity 10000
#
# 2. Copy this file to  keystore.properties  (which is gitignored) and fill in
#    the real values. Use an ABSOLUTE path for storeFile.
#
# F-Droid ignores this entirely — it builds unsigned and signs with its own key.

storeFile=/absolute/path/to/astroloop-release.jks
storePassword=CHANGEME
keyAlias=astroloop
keyPassword=CHANGEME
