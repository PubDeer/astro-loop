<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Same nose-up Scout as ic_launcher_foreground, single color for themed icons.
         Only alpha matters here — the launcher tints the glyph. Strokes are slightly
         heavier than the foreground (3/2.5 vs 2) so the tinted outline survives
         small render sizes. -->

    <!-- Scout hull — stroked outline, nose pointing up -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3"
        android:pathData="M54,26 L40,73.6 L54,65.2 L68,73.6 Z"/>

    <!-- Pilot dot — filled, center(54,45.6) radius 3 -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,45.6 m-3,0 a3,3 0 1,0 6,0 a3,3 0 1,0 -6,0"/>

    <!-- Cockpit outline -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.5"
        android:pathData="M54,40 L50.6,49.8 L57.4,49.8 Z"/>

</vector>
