<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Single-colour themed glyph. Only alpha matters — the launcher tints it.
         Strokes are heavier than the colour foreground so the tinted outline
         survives small sizes, and the pilot is a knocked-out hole so it stays
         visible against any tint instead of vanishing into one colour. -->

    <!-- Orbit ring -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.6"
        android:strokeAlpha="0.45"
        android:pathData="M54,23 a31,31 0 1,0 0,62 a31,31 0 1,0 0,-62 Z"/>

    <!-- Hull -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="5"
        android:strokeLineJoin="round"
        android:pathData="M54,21.6 L33.8,84.4 L54,71 L74.2,84.4 Z"/>

    <!-- Canopy with the pilot knocked out (evenOdd hole) -->
    <path
        android:fillColor="#FFFFFF"
        android:fillType="evenOdd"
        android:pathData="M54,37 L47.6,55 L60.4,55 Z M54,48.4 m-3.2,0 a3.2,3.2 0 1,0 6.4,0 a3.2,3.2 0 1,0 -6.4,0 Z"/>

</vector>
